PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Obrigatória: URL privada do PostgreSQL. Para demonstração local, banco sistema_leiloes.
# Em produção: conexão direta Neon com TLS, sem options/timezone/tz na URL.
DATABASE_URL=
# Obrigatório: segredo aleatório com pelo menos 32 bytes. Nunca versionar o valor.
JWT_SECRET=
# Tempo de validade do token, em segundos.
JWT_EXPIRES_IN=3600
# Exige schema/migrações compatíveis e preflight UTC aprovado; não converte LEGACY.
AUCTION_TEMPORAL_MODE=UTC_V2
# Seguro por padrão. Nunca habilitar em produção pública.
ENABLE_SIMULATED_CREDITS=false
# Na Render usar NODE_ENV=production e FRONTEND_URL igual à origem HTTPS exata do site.
# PORT é fornecida pela Render; não fixar a porta 3000 no painel de produção.
